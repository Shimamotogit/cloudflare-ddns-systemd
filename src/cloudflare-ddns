#!/usr/bin/env bash
set -Eeuo pipefail

readonly PROGRAM="cloudflare-ddns"
readonly CONFIG_FILE="${CLOUDFLARE_DDNS_CONFIG:-/etc/cloudflare-ddns/config}"
readonly STATE_DIR="${CLOUDFLARE_DDNS_STATE_DIR:-/var/lib/cloudflare-ddns}"
readonly API_BASE="https://api.cloudflare.com/client/v4"
readonly IP_CHECK_URL="https://www.cloudflare.com/cdn-cgi/trace"

DRY_RUN=false
FORCE_RECONCILE=false
CHECK_CONFIG_ONLY=false

ZONE_ID=""
RECORD_ID=""
RECORD_NAME=""
RECONCILE_INTERVAL_SECONDS=86400
API_MIN_INTERVAL_SECONDS=60
CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=15
RETRY_COUNT=2

log() {
    printf '%s: %s\n' "$PROGRAM" "$*"
}

warn() {
    printf '%s: warning: %s\n' "$PROGRAM" "$*" >&2
}

die() {
    printf '%s: error: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage: cloudflare-ddns [--dry-run] [--force-reconcile] [--check-config] [--self-test]

  --dry-run          Check public IPv4 and show intended action only.
  --force-reconcile  Verify Cloudflare now, ignoring the daily schedule.
  --check-config     Validate local configuration only.
  --self-test        Run built-in validation tests only.
USAGE
}

validate_uint_range() {
    local value="$1"
    local min="$2"
    local max="$3"

    [[ "$value" =~ ^[0-9]+$ ]] || return 1
    (( value >= min && value <= max ))
}

validate_id() {
    [[ "$1" =~ ^[0-9A-Fa-f]{32}$ ]]
}

validate_record_name() {
    local name="$1"
    local label

    (( ${#name} >= 1 && ${#name} <= 253 )) || return 1
    [[ "$name" != .* && "$name" != *. && "$name" != *..* ]] || return 1
    [[ "$name" =~ ^[A-Za-z0-9.-]+$ ]] || return 1

    local IFS='.'
    read -r -a labels <<< "$name"

    for label in "${labels[@]}"; do
        (( ${#label} >= 1 && ${#label} <= 63 )) || return 1
        [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
    done
}

validate_ipv4() {
    local ip="$1"
    local a b c d extra octet

    IFS='.' read -r a b c d extra <<< "$ip"
    [[ -n "$a" && -n "$b" && -n "$c" && -n "$d" && -z "${extra:-}" ]] || return 1

    for octet in "$a" "$b" "$c" "$d"; do
        [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
        (( 10#$octet <= 255 )) || return 1
    done
}

validate_public_ipv4() {
    local ip="$1"
    local a b c d

    validate_ipv4 "$ip" || return 1
    IFS='.' read -r a b c d <<< "$ip"

    a=$((10#$a)); b=$((10#$b)); c=$((10#$c)); d=$((10#$d))

    # Fail closed for private/special-use ranges likely to indicate bad detection.
    (( a == 0 )) && return 1
    (( a == 10 )) && return 1
    (( a == 100 && b >= 64 && b <= 127 )) && return 1
    (( a == 127 )) && return 1
    (( a == 169 && b == 254 )) && return 1
    (( a == 172 && b >= 16 && b <= 31 )) && return 1
    (( a == 192 && b == 168 )) && return 1
    (( a == 192 && b == 0 && c == 0 )) && return 1
    (( a == 192 && b == 0 && c == 2 )) && return 1
    (( a == 198 && (b == 18 || b == 19) )) && return 1
    (( a == 198 && b == 51 && c == 100 )) && return 1
    (( a == 203 && b == 0 && c == 113 )) && return 1
    (( a >= 224 )) && return 1

    return 0
}

run_self_test() {
    local failures=0

    validate_ipv4 "203.0.114.10" || { warn "valid IPv4 rejected"; failures=$((failures + 1)); }
    ! validate_ipv4 "999.1.1.1" || { warn "invalid IPv4 accepted"; failures=$((failures + 1)); }
    validate_public_ipv4 "8.8.8.8" || { warn "public IPv4 rejected"; failures=$((failures + 1)); }
    ! validate_public_ipv4 "10.0.0.1" || { warn "private IPv4 accepted"; failures=$((failures + 1)); }
    ! validate_public_ipv4 "100.64.0.1" || { warn "CGNAT IPv4 accepted"; failures=$((failures + 1)); }
    validate_id "0123456789abcdef0123456789abcdef" || { warn "valid ID rejected"; failures=$((failures + 1)); }
    ! validate_id "not-an-id" || { warn "invalid ID accepted"; failures=$((failures + 1)); }
    validate_record_name "home.example.com" || { warn "valid record name rejected"; failures=$((failures + 1)); }
    ! validate_record_name "bad name.example.com" || { warn "invalid record name accepted"; failures=$((failures + 1)); }

    (( failures == 0 )) || die "$failures self-test(s) failed"
    log "self-test passed"
}

parse_args() {
    while (( $# > 0 )); do
        case "$1" in
            --dry-run) DRY_RUN=true ;;
            --force-reconcile) FORCE_RECONCILE=true ;;
            --check-config) CHECK_CONFIG_ONLY=true ;;
            --self-test) run_self_test; exit 0 ;;
            -h|--help) usage; exit 0 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done
}

load_config() {
    [[ -r "$CONFIG_FILE" ]] || die "configuration is not readable: $CONFIG_FILE"

    local line key value
    local line_no=0

    # Never source config: only parse an explicit KEY=value allowlist.
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        line="${line%$'\r'}"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=([^[:space:]]*)$ ]] || die "invalid config syntax at line $line_no"
        key="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"

        case "$key" in
            ZONE_ID) ZONE_ID="$value" ;;
            RECORD_ID) RECORD_ID="$value" ;;
            RECORD_NAME) RECORD_NAME="$value" ;;
            RECONCILE_INTERVAL_SECONDS) RECONCILE_INTERVAL_SECONDS="$value" ;;
            API_MIN_INTERVAL_SECONDS) API_MIN_INTERVAL_SECONDS="$value" ;;
            CONNECT_TIMEOUT_SECONDS) CONNECT_TIMEOUT_SECONDS="$value" ;;
            REQUEST_TIMEOUT_SECONDS) REQUEST_TIMEOUT_SECONDS="$value" ;;
            RETRY_COUNT) RETRY_COUNT="$value" ;;
            *) die "unknown config key at line $line_no: $key" ;;
        esac
    done < "$CONFIG_FILE"
}

validate_config() {
    validate_id "$ZONE_ID" || die "ZONE_ID must be a 32-character hexadecimal ID"
    validate_id "$RECORD_ID" || die "RECORD_ID must be a 32-character hexadecimal ID"
    validate_record_name "$RECORD_NAME" || die "RECORD_NAME is invalid"
    validate_uint_range "$RECONCILE_INTERVAL_SECONDS" 0 604800 || die "RECONCILE_INTERVAL_SECONDS must be 0..604800"
    validate_uint_range "$API_MIN_INTERVAL_SECONDS" 60 3600 || die "API_MIN_INTERVAL_SECONDS must be 60..3600"
    validate_uint_range "$CONNECT_TIMEOUT_SECONDS" 1 30 || die "CONNECT_TIMEOUT_SECONDS must be 1..30"
    validate_uint_range "$REQUEST_TIMEOUT_SECONDS" 2 60 || die "REQUEST_TIMEOUT_SECONDS must be 2..60"
    (( REQUEST_TIMEOUT_SECONDS >= CONNECT_TIMEOUT_SECONDS )) || die "REQUEST_TIMEOUT_SECONDS must be >= CONNECT_TIMEOUT_SECONDS"
    validate_uint_range "$RETRY_COUNT" 0 3 || die "RETRY_COUNT must be 0..3"
}

acquire_lock() {
    local lock_file="${CLOUDFLARE_DDNS_LOCK_FILE:-/run/cloudflare-ddns/lock}"
    mkdir -p "$(dirname "$lock_file")"
    exec 9>"$lock_file"

    if ! flock -n 9; then
        log "another instance is already running; exiting"
        exit 0
    fi
}

fetch_public_ipv4() {
    local trace ip="" key value

    trace="$(
        curl \
            --disable \
            -4 \
            --silent \
            --show-error \
            --fail \
            --proto '=https' \
            --connect-timeout "$CONNECT_TIMEOUT_SECONDS" \
            --max-time "$REQUEST_TIMEOUT_SECONDS" \
            --retry "$RETRY_COUNT" \
            --retry-connrefused \
            --retry-max-time "$((REQUEST_TIMEOUT_SECONDS * (RETRY_COUNT + 1)))" \
            "$IP_CHECK_URL"
    )" || return 1

    while IFS='=' read -r key value; do
        if [[ "$key" == "ip" ]]; then
            ip="$value"
            break
        fi
    done <<< "$trace"

    validate_public_ipv4 "$ip" || return 1
    printf '%s\n' "$ip"
}

read_state_value() {
    local path="$1" value=""
    if [[ -r "$path" ]]; then
        IFS= read -r value < "$path" || true
    fi
    printf '%s' "$value"
}

atomic_write_state() {
    local path="$1" value="$2" tmp

    mkdir -p "$STATE_DIR"
    tmp="$(mktemp "$STATE_DIR/.tmp.XXXXXX")"
    printf '%s\n' "$value" > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$path"
}

reconcile_due() {
    local now="$1" last

    [[ "$FORCE_RECONCILE" == true ]] && return 0
    (( RECONCILE_INTERVAL_SECONDS == 0 )) && return 1

    last="$(read_state_value "$STATE_DIR/last_reconcile_epoch")"
    [[ "$last" =~ ^[0-9]+$ ]] || return 0
    (( now - last >= RECONCILE_INTERVAL_SECONDS ))
}

api_guard_check() {
    local now="$1" last elapsed

    last="$(read_state_value "$STATE_DIR/last_api_epoch")"
    [[ "$last" =~ ^[0-9]+$ ]] || return 0

    elapsed=$((now - last))
    if (( elapsed < API_MIN_INTERVAL_SECONDS )); then
        warn "Cloudflare API guard active; retry after $((API_MIN_INTERVAL_SECONDS - elapsed))s"
        return 1
    fi
}

load_token() {
    local credential_file token

    [[ -n "${CREDENTIALS_DIRECTORY:-}" ]] || die "systemd credential directory unavailable; run API operations via cloudflare-ddns.service"
    credential_file="$CREDENTIALS_DIRECTORY/cloudflare_api_token"
    [[ -r "$credential_file" ]] || die "Cloudflare API token credential is missing"

    IFS= read -r token < "$credential_file" || true
    token="${token%$'\r'}"
    [[ -n "$token" ]] || die "Cloudflare API token is empty"
    [[ "$token" != *[[:space:]]* ]] || die "Cloudflare API token contains whitespace"
    printf '%s' "$token"
}

cloudflare_request() {
    local method="$1" url="$2" token="$3" data="${4:-}" raw
    local -a args=(
        --disable
        --silent
        --show-error
        --proto '=https'
        --connect-timeout "$CONNECT_TIMEOUT_SECONDS"
        --max-time "$REQUEST_TIMEOUT_SECONDS"
        --retry "$RETRY_COUNT"
        --retry-connrefused
        --retry-max-time "$((REQUEST_TIMEOUT_SECONDS * (RETRY_COUNT + 1)))"
        --request "$method"
        --header @-
        --write-out $'\n%{http_code}'
        "$url"
    )

    [[ -z "$data" ]] || args+=(--data "$data")

    raw="$(
        printf 'Authorization: Bearer %s\nContent-Type: application/json\n' "$token" |
            curl "${args[@]}"
    )" || return 1

    printf '%s' "$raw"
}

split_http_response() {
    local raw="$1"
    HTTP_CODE="${raw##*$'\n'}"
    HTTP_BODY="${raw%$'\n'*}"
    [[ "$HTTP_CODE" =~ ^[0-9]{3}$ ]]
}

cloudflare_error_message() {
    local body="$1" msg
    msg="$(jq -r '[.errors[]?.message] | map(select(length > 0)) | join("; ")' <<< "$body" 2>/dev/null || true)"
    [[ -n "$msg" ]] || msg="Cloudflare API returned an error"
    printf '%s' "$msg"
}

get_remote_record() {
    local token="$1" raw parsed success type name content

    raw="$(cloudflare_request GET "$API_BASE/zones/$ZONE_ID/dns_records/$RECORD_ID" "$token")" || die "Cloudflare DNS record lookup failed after bounded retries"
    split_http_response "$raw" || die "could not parse Cloudflare HTTP status"

    if [[ "$HTTP_CODE" != 2* ]]; then
        die "Cloudflare DNS record lookup failed (HTTP $HTTP_CODE): $(cloudflare_error_message "$HTTP_BODY")"
    fi

    parsed="$(jq -r '[.success, (.result.type // ""), (.result.name // ""), (.result.content // "")] | @tsv' <<< "$HTTP_BODY" 2>/dev/null)" || die "Cloudflare returned invalid JSON"
    IFS=$'\t' read -r success type name content <<< "$parsed"

    [[ "$success" == "true" ]] || die "Cloudflare reported an unsuccessful DNS lookup"
    [[ "$type" == "A" ]] || die "target record is not type A; refusing to modify it"
    [[ "${name,,}" == "${RECORD_NAME,,}" ]] || die "target record name mismatch; refusing to modify it"
    validate_ipv4 "$content" || die "Cloudflare record content is not a valid IPv4 address"

    printf '%s\n' "$content"
}

patch_remote_record() {
    local token="$1" desired_ip="$2" payload raw parsed success type name content

    # Intentionally change only content so TTL/proxy/name/type remain untouched.
    payload="{\"content\":\"$desired_ip\"}"
    raw="$(cloudflare_request PATCH "$API_BASE/zones/$ZONE_ID/dns_records/$RECORD_ID" "$token" "$payload")" || die "Cloudflare DNS update failed after bounded retries"
    split_http_response "$raw" || die "could not parse Cloudflare HTTP status"

    if [[ "$HTTP_CODE" != 2* ]]; then
        die "Cloudflare DNS update failed (HTTP $HTTP_CODE): $(cloudflare_error_message "$HTTP_BODY")"
    fi

    parsed="$(jq -r '[.success, (.result.type // ""), (.result.name // ""), (.result.content // "")] | @tsv' <<< "$HTTP_BODY" 2>/dev/null)" || die "Cloudflare returned invalid JSON after update"
    IFS=$'\t' read -r success type name content <<< "$parsed"

    [[ "$success" == "true" ]] || die "Cloudflare reported an unsuccessful DNS update"
    [[ "$type" == "A" ]] || die "Cloudflare update response changed record type unexpectedly"
    [[ "${name,,}" == "${RECORD_NAME,,}" ]] || die "Cloudflare update response record name mismatch"
    [[ "$content" == "$desired_ip" ]] || die "Cloudflare update response content mismatch"
}

main() {
    parse_args "$@"
    load_config
    validate_config

    if [[ "$CHECK_CONFIG_ONLY" == true ]]; then
        log "configuration is valid"
        exit 0
    fi

    acquire_lock

    local current_ip last_ip now due=false token remote_ip
    current_ip="$(fetch_public_ipv4)" || die "could not obtain a valid public IPv4 address from Cloudflare trace"
    now="$(date +%s)"
    last_ip="$(read_state_value "$STATE_DIR/last_ipv4")"
    reconcile_due "$now" && due=true

    if [[ "$DRY_RUN" == true ]]; then
        if [[ "$current_ip" == "$last_ip" && "$due" == false ]]; then
            log "dry-run: IPv4 unchanged ($current_ip); no action"
        elif [[ "$current_ip" == "$last_ip" ]]; then
            log "dry-run: IPv4 unchanged ($current_ip); reconciliation would query Cloudflare"
        else
            log "dry-run: IPv4 is $current_ip; Cloudflare would be verified before update"
        fi
        exit 0
    fi

    # Normal path: no Cloudflare DNS API traffic when nothing changed.
    if [[ "$current_ip" == "$last_ip" && "$due" == false ]]; then
        exit 0
    fi

    if ! api_guard_check "$now"; then
        exit 0
    fi

    # Record the attempt before API use so failed/terminated runs are rate-guarded too.
    atomic_write_state "$STATE_DIR/last_api_epoch" "$now"
    token="$(load_token)"
    remote_ip="$(get_remote_record "$token")"

    if [[ "$remote_ip" == "$current_ip" ]]; then
        atomic_write_state "$STATE_DIR/last_ipv4" "$current_ip"
        atomic_write_state "$STATE_DIR/last_reconcile_epoch" "$now"
        log "Cloudflare record is already current ($RECORD_NAME -> $current_ip)"
        exit 0
    fi

    patch_remote_record "$token" "$current_ip"

    # Advance state only after Cloudflare confirms the desired content.
    atomic_write_state "$STATE_DIR/last_ipv4" "$current_ip"
    atomic_write_state "$STATE_DIR/last_reconcile_epoch" "$now"
    log "updated $RECORD_NAME: $remote_ip -> $current_ip"
}

main "$@"
